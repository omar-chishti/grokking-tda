+experiment=tf_mod97_grok run_name=transformer_add97_f0.3_wd0.1_traj_s3 seed=3 train.optimizer.weight_decay=0.1 train.steps=150000 train.capture_representations=false train.n_snapshots=150 train.trajectory_dim=128 train.trajectory_every=20
