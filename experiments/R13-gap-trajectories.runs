+experiment=tf_mod97_grok run_name=transformer_add97_f0.2_wd1.0_traj_s3 seed=3 data.train_fraction=0.2 train.steps=60000 train.capture_representations=false train.n_snapshots=150 train.trajectory_dim=128 train.trajectory_every=20
+experiment=tf_mod97_grok run_name=transformer_add97_f0.2_wd1.0_traj_s4 seed=4 data.train_fraction=0.2 train.steps=60000 train.capture_representations=false train.n_snapshots=150 train.trajectory_dim=128 train.trajectory_every=20

