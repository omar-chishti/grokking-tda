# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# uv: track the lockfile (reproducibility), ignore the resolved venv
.venv/
venv/

# Build outputs
build/
dist/
*.egg-info/

# Environment / secrets
.env
.env.*

# Research outputs (artifact store) — heavy, regenerable
results/raw/*
results/processed/*
results/figures/*
!results/raw/.gitkeep
!results/processed/.gitkeep
!results/figures/.gitkeep
# The tidy tables behind every number and figure in the thesis are small and are the only
# way a reader without the raw store can check one, so they are tracked.
!results/processed/thesis/
!results/processed/thesis/**

# Checkpoints and large artifacts
*.pt
*.pth
*.ckpt
*.npz
*.npy
*.pkl
*.joblib

# Local run logs
logs/
.fontcache/

# Remote worker state — per-machine, regenerated by `gtda-remote probe`
results/.remote/
results-sidequest/.remote/

# The side quest trains into its own tree so that nothing reading the bank can see it
# (Documentation/SideQuest_Orientation_2026-09-03.md §5). Same rule as above: the tidy
# tables are tracked, the artifact store is not.
results-sidequest/raw/*
results-sidequest/figures/*
results-sidequest/*.log
